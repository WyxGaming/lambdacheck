# Supabase Auth (public keys — safe in the browser).
# Create a project at https://supabase.com then copy Project URL + anon key.
# Enable Confirm email in Authentication → Providers → Email.
# Add these Redirect URLs:
#   http://127.0.0.1:43127/confirmation
#   https://lambdacheck1.vercel.app/confirmation
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
